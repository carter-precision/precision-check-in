# Supabase
NEXT_PUBLIC_SUPABASE_URL=local_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=local_public_supabase_key
SUPABASE_SECRET_KEY=local_secret_supabase_key

# Omega
OMEGA_API_KEY=omega_api_key
OMEGA_API_URL=http://127.0.0.1:4010/api/2.0
OMEGA_LOCATION_MAP={"1": "layton", "2": "centerville", "3": "ogden", "5": "st-george", "6": "cedar-city", "8": "south-jordan"}
OMEGA_DEFAULT_TIME_ZONE=America/Denver
OMEGA_SCHEDULING_SECRET=12345678901234567890123456789012
# Optional: set this to the exact hold reason configured in Omega.
OMEGA_KIOSK_HOLD_REASON=Kiosk scheduling request
CHECK_IN_PROOF_SECRET=12345678901234567890123456789032

# Auth
DEVICE_SETUP_PASSWORD=device_setup_password
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
